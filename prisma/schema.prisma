datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id        String   @id @default(uuid())
  name      String
  scans     Scan[]
  createdAt DateTime @default(now())
}

model Scan {
  id            String    @id @default(uuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetUrl     String?
  scanType      String    
  status        String    
  securityScore Int       @default(100)
  durationMs    Int       @default(0)
  findings      Finding[]
  createdAt     DateTime  @default(now())
  userId        String?
  userEmail     String?
  userName      String?
  ipAddress     String?
  userAgent     String?
  city          String?
  country       String?
}

model Finding {
  id                String   @id @default(uuid())
  scanId            String
  scan              Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title             String
  severity          String   
  confidence        String   @default("HIGH")
  description       String
  riskExplanation   String   @db.Text
  attackScenario    String   @db.Text
  affectedComponent String   @default("Network")
  lineNumber        Int      @default(0)
  recommendation    String   @db.Text
  secureCodeExample String   @db.Text
  checklistSteps    String[] @default([])
  createdAt         DateTime @default(now())
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  isBanned   Boolean   @default(false)
  banReason  String?
  bannedAt   DateTime?
  createdAt  DateTime  @default(now())
}

model FeatureCard {
  id        String   @id @default(uuid())
  name      String
  desc      String
  icon      String   @default("✨")
  link      String
  bg        String   @default("#4338ca")
  accent    String   @default("#a5b4fc")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiQuery {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  intent    String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model ScheduledScan {
  id          String   @id @default(uuid())
  targetUrl   String
  label       String?
  cadence     String   @default("daily")   // "hourly" | "daily" | "weekly"
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime
  lastScore   Int?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TelegramConfig {
  id        String   @id
  botToken  String?
  chatId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecurecheckPayment {
  id                 String   @id @default(uuid())
  deviceId           String
  reference          String
  amount             Float    @default(10)
  momoNumber         String   @default("0599931348")
  momoTransactionId  String   @default("")
  phoneUsed          String   @default("")
  status             String   @default("pending_review") // pending_review | approved | rejected
  unlockedAt         DateTime?
  unlockedUntil      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([deviceId])
  @@index([reference])
  @@index([status])
}

model SecurecheckQuota {
  id        String   @id @default(uuid())
  deviceId  String
  date      String   // YYYY-MM-DD
  usedToday Int      @default(0)
  freeLimit Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, date])
  @@index([deviceId])
}
